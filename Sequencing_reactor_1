from gekko import GEKKO

# Data
t={
    1: {1:3.5, 2:4.3, 3:8.7},
    2: {1:4.0, 2:5.5, 3:3.5},
    3: {1:3.5, 2:7.5, 3:6.0},
    4: {1:12.0, 2:3.5, 3:8.0},
  }
P=S=[1, 2, 3, 4] # As many products as slots
U=[1, 2, 3]
m=GEKKO(remote=False) # Initialize gekko
m.options.SOLVER=1

# Variables
X={}
for i in P:
    for j in S:
        X[i,j]=m.Var(lb=0, ub=1, integer=True) # Binary variable
C={}
for j in S:
    for k in U:
        C[j,k]=m.Var(lb=0) # Continuous variable, lb=0 covers the C >= 0 part of (h)

# (d) One product per slot
for j in S:
    m.Equation(sum(X[i,j] for i in P)==1) ##Looks like this: X[1,j]+ X[2,j]+ X[3,j]+ X[4,j]==1
# (e) One slot per product
for i in P:
    m.Equation(sum(X[i,j] for j in S)==1) ##Looks like this: X[i,1]+ X[i,2]+ X[i,3]+ X[i,4]==1

# (g) first line, units 2 and 3: leave unit k after leaving the previous unit plus processing
for j in S:
    for k in U[1:]:
        m.Equation(C[j,k] >= C[j,k-1] + sum(t[i][k]*X[i,j] for i in P))

# (g) second line, unit 1, slot 1: starts at time zero
m.Equation(C[1,1] >= sum(t[i][1]*X[i,1] for i in P))

# (g) second line, unit 1, slots 2 to 4: wait for the previous slot to leave unit 1
for j in S[1:]:
    m.Equation(C[j,1] >= C[j-1,1] + sum(t[i][1]*X[i,j] for i in P))

# (c) blocking: cannot leave unit k until the previous slot has left unit k+1
for j in S[1:]:
    for k in U[:-1]:
        m.Equation(C[j,k] >= C[j-1,k+1])

# Objective: minimize the makespan, the last slot leaving the last unit
m.Minimize(C[4,3])
m.solve(disp=False)

# Results
sequence=[i for j in S for i in P if X[i,j].value[0] > 0.5]
print("Sequence:", ["p%d" % i for i in sequence])
print("Makespan:", round(C[4,3].value[0], 2), "h")
for j in S:
    print("Slot", j, [round(C[j,k].value[0], 2) for k in U])