# Variables
X={}
for i in P:
    for j in S:
        X[i,j]=m.Var(lb=0, ub=1, integer=True) # Binary variable
C={}
for j in S:
    for k in U:
        C[j,k]=m.Var(lb=0) # Continuous variable

# One product per slot
for j in S:
    m.Equation(sum(X[i,j] for i in P)==1) ##Looks like this: X[i,1]+ X[i,2]+ X[i,3]+ X[i,4]==1
# One slot per product
for i in P:
